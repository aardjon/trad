{
    "name": "aardjon/trad.ota",
    "version": "0.1.0",
    "description": "Server backend of the trad route database online updater",
    "type": "project",
    "license": "EUPL-1.2",
    "authors": [
        {
            "name": "Thomas Wesenigk",
            "role": "Developer"
        },
        {
            "name": "Karsten Wesenigk",
            "role": "Developer"
        }
    ],
    "require-dev": {
        "lkrms/pretty-php": "^0.4.95",
        "vimeo/psalm": "^6.16",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "analyze": "vendor/bin/phpstan && vendor/bin/psalm --no-cache",
        "format": "vendor/bin/pretty-php",
        "upgrade": "composer update"
    },
    "require": {
        "monolog/monolog": "^2.11"
    },
    "autoload": {
        "psr-4": {
            "trad\\": "src"
        }
    }
}
